# TRUSTNEXUS AI - Frontend Environment Configuration

# Local Development (Default):
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/events

# Production Settings (Configure these in Netlify Site Configuration -> Environment Variables):
# Replace with your actual Render service URL after deployment:
# VITE_API_URL=https://<RENDER_BACKEND_URL>
# VITE_WS_URL=wss://<RENDER_BACKEND_URL>/ws/events
